<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 26100 projection is needed for LampArray.IsAvailable (Dynamic Lighting background control) -->
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <!-- side-by-side manifest that ties the exe to the GameLightSync sparse package (app identity) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>GameLightSync</AssemblyName>
    <RootNamespace>GameLightSync</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RazerSdkReader" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Compile Remove="dist\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Official Logitech LED SDK 9.00 wrapper (x64), talks to G HUB -->
    <None Include="lib\LogitechLedEnginesWrapper.dll" Link="LogitechLedEnginesWrapper.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('lib\LogitechLedEnginesWrapper.dll')" />
    <!-- defaults only; the app creates bridge.json from it on first start, so builds never overwrite user settings -->
    <None Include="bridge.default.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
